# ==========================================================================
# NurseFlow back-end — desenvolvimento local (npm run dev / npm run start:dev)
# Uso: cp .env.example .env   (dentro de back-end/)
# O .env real é ignorado pelo Git. NUNCA versione credenciais.
#
# O MongoDB local é o de db/docker-compose.yml (npm run db:up): sem autenticação,
# publicado em localhost:27017. Para a stack Docker completa use o .env.example da raiz.
# ==========================================================================

# --- Aplicação ---
NODE_ENV=development
PORT=3000
# Origens permitidas pelo CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173

# --- MongoDB (inclui o nome do banco) ---
MONGODB_URI=mongodb://localhost:27017/nurseflow

# --- Autenticação JWT ---
# Chave aleatória com 16 caracteres ou mais:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
JWT_SECRET=SUBSTITUA_POR_CHAVE_ALEATORIA_COM_32_CARACTERES_OU_MAIS
JWT_EXPIRES_IN_SECONDS=28800

# --- Bloqueio temporário após tentativas inválidas de login ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Recuperação de senha ---
PASSWORD_RESET_TTL_MINUTES=30

# --- Otimizador de escalas (npm run db:up sobe o serviço em localhost:8000) ---
OPTIMIZER_URL=http://localhost:8000
# Tempo máximo do solver por geração (segundos) e timeout da chamada HTTP (ms)
OPTIMIZER_TIME_LIMIT_SECONDS=30
OPTIMIZER_TIMEOUT_MS=120000

# --- Conta inicial da Coordenação (npm run seed:coordenacao) ---
SEED_COORDENACAO_NOME=Coordenacao NurseFlow
SEED_COORDENACAO_EMAIL=coordenacao@exemplo.com
# CPF válido (somente dígitos ou formatado)
SEED_COORDENACAO_CPF=52998224725
# De 8 a 72 caracteres
SEED_COORDENACAO_SENHA=SUBSTITUA_POR_SENHA_FORTE

# --- Dados de demonstração (npm run seed:demo) — SOMENTE desenvolvimento local ---
DEMO_SEED_ENABLED=false
# De 8 a 72 caracteres. Obrigatórias quando DEMO_SEED_ENABLED=true.
DEMO_ADMIN_PASSWORD=
DEMO_PRO_PASSWORD=
