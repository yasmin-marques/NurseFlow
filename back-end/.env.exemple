# ==========================================
# NURSEFLOW — CONFIGURAÇÃO DO BACKEND
# ==========================================

# Aplicação
NODE_ENV=development
PORT=3000

# CORS — Endereços permitidos do frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB — Banco local via Docker
MONGODB_URI=mongodb://localhost:27017/nurseflow

# Autenticação JWT
# Gere uma chave forte e exclusiva no seu .env
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_SEGURA
JWT_EXPIRES_IN_SECONDS=28800

# Proteção contra tentativas inválidas
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Recuperação de senha
PASSWORD_RESET_TTL_MINUTES=30

# ==========================================
# CONTA INICIAL DA COORDENAÇÃO
# ==========================================

SEED_COORDENACAO_NOME=Coordenacao NurseFlow
SEED_COORDENACAO_EMAIL=coordenacao@exemplo.com
SEED_COORDENACAO_CPF=52998224725
SEED_COORDENACAO_SENHA=SUBSTITUA_POR_UMA_SENHA_FORTE