# ==========================================================================
# NurseFlow — variáveis do Docker Compose (stack completa)
# Uso: cp .env.example .env   (na raiz, ao lado do docker-compose.yml)
# O .env real é ignorado pelo Git. NUNCA versione credenciais.
#
# Para desenvolvimento local (npm run dev) use back-end/.env.example.
# ==========================================================================

# --- MongoDB (container "mongo") ---
MONGO_ROOT_USERNAME=nurseflow_admin
# Gere valores com:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Use senha sem caracteres reservados de URL (@ : / ? # %) ou codifique-a na MONGODB_URI.
MONGO_ROOT_PASSWORD=SUBSTITUA_POR_SENHA_FORTE
# O host é o nome do serviço ("mongo"), não "localhost". A senha deve ser a mesma de MONGO_ROOT_PASSWORD.
MONGODB_URI=mongodb://nurseflow_admin:SUBSTITUA_POR_SENHA_FORTE@mongo:27017/nurseflow?authSource=admin

# --- Backend ---
# Chave aleatória com 16 caracteres ou mais (ex.: gerada com o comando acima).
JWT_SECRET=SUBSTITUA_POR_CHAVE_ALEATORIA_COM_32_CARACTERES_OU_MAIS
JWT_EXPIRES_IN_SECONDS=28800
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
# Origens permitidas pelo CORS (o frontend em Docker usa o proxy /api, então normalmente não é necessário).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Otimizador de escalas (serviço "optimizer"; a URL é fixa no Compose) ---
# Tempo máximo do solver por geração (segundos) e timeout da chamada HTTP (ms).
OPTIMIZER_TIME_LIMIT_SECONDS=30
OPTIMIZER_TIMEOUT_MS=120000

# --- Portas publicadas no host ---
BACKEND_PORT=3000
FRONTEND_PORT=8080

# --- Conta inicial da Coordenação (npm run seed:coordenacao / docker compose exec backend ...) ---
SEED_COORDENACAO_NOME=Coordenacao NurseFlow
SEED_COORDENACAO_EMAIL=coordenacao@exemplo.com
# CPF válido (somente dígitos ou formatado)
SEED_COORDENACAO_CPF=52998224725
# De 8 a 72 caracteres
SEED_COORDENACAO_SENHA=SUBSTITUA_POR_SENHA_FORTE

# --- Dados de demonstração (SOMENTE desenvolvimento local) ---
# Com "true", o serviço seed-demo cria usuários, profissionais, setores, configurações e restrições fictícios.
DEMO_SEED_ENABLED=false
# De 8 a 72 caracteres. Obrigatórias quando DEMO_SEED_ENABLED=true.
DEMO_ADMIN_PASSWORD=
DEMO_PRO_PASSWORD=
