MONGO_ROOT_PASSWORD=SUBSTITUA_POR_SENHA_FORTE
MONGODB_URI=mongodb://nurseflow_admin:SUBSTITUA_POR_SENHA_FORTE@mongo:27017/nurseflow?authSource=admin
JWT_SECRET=SUBSTITUA_POR_CHAVE_ALEATORIA_COM_32_CARACTERES_OU_MAIS
BACKEND_PORT=3000
CORS_ORIGINS=http://localhost:5173
JWT_EXPIRES_IN_SECONDS=28800
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
